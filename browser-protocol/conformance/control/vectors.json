[
  {
    "name": "hello-snapshot",
    "kind": "connect"
  },
  {
    "name": "start-by-tab-id",
    "commands": [
      {
        "type": "command",
        "requestId": "record",
        "action": "start",
        "tabId": 2,
        "mode": "tracks"
      }
    ],
    "expect": [
      {
        "ok": true,
        "recording": true,
        "tabId": 2
      }
    ]
  },
  {
    "name": "stop-scoped-to-tab",
    "commands": [
      {
        "type": "command",
        "requestId": "record",
        "action": "start",
        "tabId": 2,
        "mode": "tracks"
      },
      {
        "type": "command",
        "requestId": "wrong-stop",
        "action": "stop",
        "tabId": 99
      },
      {
        "type": "command",
        "requestId": "stop",
        "action": "stop",
        "tabId": 2
      }
    ],
    "expect": [
      {
        "ok": true,
        "recording": true,
        "tabId": 2
      },
      {
        "ok": false,
        "error": "A recording is already running. Stop it before starting another."
      },
      {
        "ok": true,
        "recording": false,
        "tabId": 2
      }
    ]
  },
  {
    "name": "duplicate-request-id",
    "commands": [
      {
        "type": "command",
        "requestId": "record",
        "action": "start",
        "tabId": 2,
