{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "createdAt",
    "title",
    "source",
    "state",
    "tracks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "source": {
      "enum": [
        "chromium",
        "macos",
        "gnome",
        "recovered"
      ]
    },
    "state": {
      "enum": [
        "recording",
        "completed",
        "interrupted"
      ]
    },
    "problem": {
      "type": [
        "string",
        "null"
      ]
    },
    "problemKind": {
      "enum": [
        "empty",
        "capture",
        "io",
        "recovery",
        "gap",
        null
      ]
    },
    "tracks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "file",
          "sampleRate",
          "channels",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "$comment": "At most 200 UTF-8 bytes",
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "local",
              "remote",
              "media",
              "tab",
              "microphone",
              "application",
              "system"
            ]
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 8000,
            "maximum": 192000,
            "$comment": "Raw JSON must use an integer literal: schema alone cannot distinguish 48000.0."
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2,
            "$comment": "Raw JSON must use an integer literal: schema alone cannot distinguish 48000.0."
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "pattern": "^track-[^/\\\\]+\\.wav$"
          },
          "frames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483629,
            "$comment": "Maximum mono PCM16 frames = floor((2^32-1-36)/2); the byte bound is stricter for stereo."
          },
          "startOffsetMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 86400000
          },
          "endOffsetMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 86460000
          },
          "ended": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "labelSource": {
            "enum": [
              "browser",
              "device",
              "user",
              "recovered",
              null
            ]
          },
          "sourceTrackId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200,
            "$comment": "Opaque source identity, at most 200 UTF-8 bytes in addition to the Unicode length limit. Omit when unknown, and for microphone/system sources. Never derive identity from labels."
          },
          "gapFrames": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483629
          },
          "droppedFrames": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483629
          },
          "captureOutcome": {
            "enum": [
              "captured",
              "neverAudio",
              "lowAudio",
              "failed"
            ]
          },
          "receivedFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483629
          },
          "problemKind": {
            "enum": [
              "capture",
              "io"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sessionEvent"
      },
      "$comment": "S-6: optional append-only session timeline, ordered by non-decreasing finite atMs. Readers ignore unknown types/fields. The ordering and UTF-8 source-ID byte bound require checks beyond JSON Schema. D33: at most one terminal end; ordering, terminal position and restored transition checks are also required.",
      "contains": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "end"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "captureOutcome": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceTrackId",
              "kind",
              "captureOutcome",
              "audioMs",
              "trackIds"
            ],
            "properties": {
              "sourceTrackId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
              },
              "kind": {
                "enum": [
                  "local",
                  "remote",
                  "media",
                  "tab",
                  "microphone",
                  "application",
                  "system"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "captureOutcome": {
                "enum": [
                  "captured",
                  "neverAudio",
                  "lowAudio",
                  "failed"
                ]
              },
              "audioMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400000
              },
              "trackIds": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
                }
              }
            },
            "additionalProperties": true
          }
        },
        "unreportedSourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "problem": {
            "type": "null"
          },
          "problemKind": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "interrupted"
          }
        }
      },
      "then": {
        "required": [
          "problem"
        ],
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sessionEvent": {
      "type": "object",
      "required": [
        "atMs",
        "type"
      ],
      "properties": {
        "atMs": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "othersSource"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "reason"
            ],
            "properties": {
              "source": {
                "enum": [
                  "browser",
                  "system",
                  "none"
                ]
              },
              "reason": {
                "enum": [
                  "start",
                  "missing",
                  "lost",
                  "user",
                  "restored",
                  "callConnected"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "reason": {
                      "enum": [
                        "restored",
                        "callConnected"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "source": {
                      "const": "browser"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "selection"
              }
            }
          },
          "then": {
            "required": [
              "me",
              "others",
              "reason"
            ],
            "properties": {
              "me": {
                "type": "boolean"
              },
              "others": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "start",
                  "user"
                ]
              }
            },
            "anyOf": [
              {
                "properties": {
                  "me": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "others": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "user",
                  "callEnded",
                  "tabClosed",
                  "pageGone",
                  "disk",
                  "error",
                  "appQuit"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
