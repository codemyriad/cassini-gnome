{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cassini native request v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "start"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            1,
            null
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "kind",
        "sampleRate",
        "channels"
      ],
      "properties": {
        "type": {
          "const": "track"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "$comment": "At most 200 UTF-8 bytes",
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "local",
            "remote",
            "media",
            "tab",
            "microphone",
            "application",
            "system"
          ]
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000,
          "$comment": "Raw JSON must use an integer literal: schema alone cannot distinguish 48000.0."
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "$comment": "Raw JSON must use an integer literal: schema alone cannot distinguish 48000.0."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceTrackId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "sequence",
        "offsetMs",
        "pcm"
      ],
      "properties": {
        "type": {
          "const": "audio"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "$comment": "At most 200 UTF-8 bytes"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "$comment": "Raw JSON must use an integer literal: schema alone cannot distinguish 48000.0."
        },
        "offsetMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 349528,
          "contentEncoding": "base64"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "stop"
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "enum": [
            "user",
            "callEnded",
            "tabClosed",
            "pageGone",
            "disk",
            "error",
            "appQuit"
          ]
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        },
        "discoveredSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/discoveredSource"
          },
          "$comment": "The framed JSON size limit bounds diagnostics; the separate 64-track limit bounds audio allocation."
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "reason",
        "droppedFrames",
        "endOffsetMs"
      ],
      "properties": {
        "type": {
          "const": "trackEnd"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        },
        "reason": {
          "enum": [
            "ended",
            "replaced",
            "retry",
            "stopped",
            "failed",
            "callChanged"
          ]
        },
        "droppedFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483629
        },
        "endOffsetMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 86460000
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "discoveredSources"
      ],
      "properties": {
        "type": {
          "const": "sources"
        },
        "discoveredSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/discoveredSource"
          },
          "$comment": "Negotiated source-outcomes-v1 only. Bounded by native framing; does not allocate a WAV."
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "version",
        "independent",
        "captureId",
        "timelineOriginMs",
        "callGeneration",
        "features"
      ],
      "properties": {
        "type": {
          "const": "resume"
        },
        "version": {
          "const": 1
        },
        "independent": {
          "const": true
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$comment": "At most128 UTF-8 bytes; opaque active native capture identity."
        },
        "timelineOriginMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799000
        },
        "callGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "features": {
          "type": "array",
          "contains": {
            "const": "resume-capture-v1"
          },
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "discoveredSource": {
      "type": "object",
      "required": [
        "sourceTrackId",
        "kind"
      ],
      "properties": {
        "sourceTrackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        },
        "kind": {
          "enum": [
            "local",
            "remote",
            "media",
            "tab",
            "application"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "failed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
