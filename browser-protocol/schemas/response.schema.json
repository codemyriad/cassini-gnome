{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "started",
        "ack",
        "stopped",
        "error"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "problem": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "enum": [
        "version",
        "state",
        "source",
        "sequence",
        "chunk",
        "limit",
        "io",
        "framing"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "started",
              "stopped"
            ]
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "message"
        ]
      }
    }
  ]
}
