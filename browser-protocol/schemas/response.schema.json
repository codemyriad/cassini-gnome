{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "started",
        "ack",
        "stopped",
        "error"
      ]
    },
    "path": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "code": {
      "enum": [
        "version",
        "state",
        "source",
        "sequence",
        "chunk",
        "limit",
        "io",
        "framing"
      ]
    }
  },
  "additionalProperties": true
}
