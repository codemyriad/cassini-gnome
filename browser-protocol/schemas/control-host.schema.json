{
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ping"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "seq"
      ],
      "additionalProperties": true,
      "$comment": "heartbeat-v1: sent only to a peer whose hello lists heartbeat-v1, after its first status."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "configure"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "call-signals-v1",
              "verified-auto-admission-v1"
            ]
          },
          "allOf": [
            {
              "if": {
                "contains": {
                  "const": "verified-auto-admission-v1"
                }
              },
              "then": {
                "contains": {
                  "const": "call-signals-v1"
                }
              }
            }
          ]
        }
      },
      "required": [
        "type",
        "capabilities"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "recordRequests"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "enabled"
      ],
      "additionalProperties": false,
      "$comment": "popup-record-v1: per-connection opt-in (true) or revocation (false); sent only to a peer whose hello lists popup-record-v1. Reconnect starts opted out."
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "recordRequestResult"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,32}$"
        }
      },
      "required": [
        "type",
        "requestId",
        "ok"
      ],
      "additionalProperties": true,
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "$comment": "popup-record-v1: the app's one answer to a recordRequest. ok:true means the app accepted the ask and has sent (or will promptly send) its own ordinary start/stop command; it is not recording confirmation."
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "requestId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "action": {
          "enum": [
            "start",
            "stop",
            "reloadTab"
          ]
        },
        "tabId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "independent": {
          "type": "boolean"
        },
        "captureLocal": {
          "type": "boolean"
        },
        "microphone": {
          "type": "boolean"
        },
        "keepOnNavigation": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "user",
            "callEnded",
            "tabClosed",
            "pageGone",
            "disk",
            "error",
            "appQuit"
          ]
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        },
        "callGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resumeCapture": {
          "type": "object",
          "required": [
            "captureId",
            "timelineOriginMs",
            "lostAtMs"
          ],
          "properties": {
            "captureId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "$comment": "At most128 UTF-8 bytes; opaque active native capture identity."
            },
            "timelineOriginMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799000
            },
            "lostAtMs": {
              "type": "number",
              "minimum": 0,
              "$comment": "R94: hosts MUST send this finite nonnegative number, copied after the durable checkpoint under the capture lock: the atMs of the committed othersSource seam the ask resumes (newest system/lost, or the system/missing stand-in), exactly as the host wrote it in session.json. The extension does not read it: it accepts a resumeCapture without it and never forwards it to the native resume packet."
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "requestId",
        "action",
        "tabId"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "start"
              }
            }
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "tracks"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "keepOnNavigation"
            ],
            "properties": {
              "keepOnNavigation": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "independent"
            ],
            "properties": {
              "independent": {
                "const": true
              },
              "action": {
                "const": "start"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "stop"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "resumeCapture"
            ]
          },
          "then": {
            "required": [
              "independent",
              "callGeneration"
            ],
            "properties": {
              "independent": {
                "const": true
              },
              "action": {
                "const": "start"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
