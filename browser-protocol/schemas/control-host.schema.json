{
  "type": "object",
  "properties": {
    "type": {
      "const": "command"
    },
    "requestId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "action": {
      "enum": [
        "start",
        "stop"
      ]
    },
    "tabId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "independent": {
      "type": "boolean"
    },
    "captureLocal": {
      "type": "boolean"
    },
    "microphone": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "requestId",
    "action",
    "tabId"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "start"
          }
        }
      },
      "then": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "tracks"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
