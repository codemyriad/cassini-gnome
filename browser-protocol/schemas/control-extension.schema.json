                  "properties": {
                    "remoteAudio": {
                      "enum": [
                        "separated",
                        "mixed"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "callEvidence": {
                      "properties": {
                        "adapter": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
