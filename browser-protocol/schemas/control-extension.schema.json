            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "tracks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stopping": {
          "type": "boolean"
        },
        "sessions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "recording": {
                "type": "boolean"
              },
              "tabId": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              },
              "tracks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
