          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "seq"
      ],
      "additionalProperties": true,
      "$comment": "heartbeat-v1: only ever a reply echoing an app ping's seq; never unsolicited."
    }
