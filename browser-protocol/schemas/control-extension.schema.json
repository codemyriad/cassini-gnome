                "type": "integer",
                "minimum": 0,
                "maximum": 253402300799000
              }
            },
            "required": [
              "recording",
              "tabId",
              "path",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "pageState": {
          "enum": [
            "present",
            "closed",
            "navigating"
          ]
        },
        "failedSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "documentGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "callGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "$comment": "At most 200 UTF-8 bytes, independently of this character bound."
        },
        "timelineOriginMs": {
          "type": "integer",
