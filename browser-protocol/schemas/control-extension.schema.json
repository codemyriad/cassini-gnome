                  "reason": {
                    "enum": [
                      "unverified",
                      "unsupported",
                      "evidenceConflict",
                      "activeCall",
                      "callEnded",
                      "nonCall"
                    ]
                  },
                  "adapter": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "name",
                          "version"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "callGeneration": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "state",
                  "reason",
                  "adapter",
                  "callGeneration"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "state"
                      ],
                      "properties": {
                        "state": {
                          "const": "active"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "activeCall"
                        },
                        "adapter": {
                          "type": "object"
                        },
                        "callGeneration": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "state"
                      ],
                      "properties": {
                        "state": {
                          "const": "inactive"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "enum": [
                            "callEnded",
                            "nonCall"
                          ]
                        },
                        "adapter": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "state"
                      ],
                      "properties": {
                        "state": {
                          "const": "unknown"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "enum": [
                            "unverified",
                            "unsupported",
                            "evidenceConflict"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "reason"
                      ],
                      "properties": {
                        "reason": {
                          "const": "callEnded"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "callGeneration": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    }
                  }
                ]
              }
            },
