import gettext
import locale
import os
import signal
import sys
from pathlib import Path

VERSION = "@VERSION@"
APPLICATION_ID = "@APPLICATION_ID@"
PROFILE = "@PROFILE@"
pkgdatadir = "@pkgdatadir@"
localedir = "@localedir@"

# Local installations must also work when launched directly or by the browser.
share = Path(pkgdatadir).parent
schemas = share / "glib-2.0" / "schemas"
if (schemas / "gschemas.compiled").is_file():
    os.environ.setdefault("GSETTINGS_SCHEMA_DIR", str(schemas))
os.environ["XDG_DATA_DIRS"] = str(share) + ":" + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass  # An unavailable desktop locale keeps the existing C-locale fallback.
locale.bindtextdomain("cassini-viewer", localedir)
locale.textdomain("cassini-viewer")
gettext.install("cassini-viewer", localedir)

if __name__ == "__main__":
    # Freeze the running identity before lazy imports can see a later upgrade.
    from cassini_viewer.installed_build import InstalledBuild

    installed = InstalledBuild(pkgdatadir, Path(__file__).resolve(), VERSION,
                               flatpak=bool(os.environ.get("FLATPAK_ID")))
    from cassini_viewer import runtime

    runtime.check()

    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, "cassini-viewer.gresource"))
    resource._register()

    if os.environ.get("CASSINI_SCREENSHOT_OUT"):
        from cassini_viewer.screenshot import capture
        sys.exit(capture(APPLICATION_ID, VERSION, PROFILE))
    from cassini_viewer import main

    result = main.main(APPLICATION_ID, VERSION, PROFILE, installed_build=installed)
    if installed.restart is not None:
        installed.reexec(**installed.restart)
    sys.exit(result)
