{
 "type": "object",
 "properties": {
  "version": {
   "type": "integer",
   "const": 1
  },
  "revision": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "id": {
   "type": "string",
   "format": "uuid"
  },
  "title": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1,
   "maxLength": 500
  },
  "titleSource": {
   "enum": [
    "meeting-window",
    "user"
   ]
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "atMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "text": {
      "type": "string",
      "maxLength": 100000
     }
    },
    "required": [
     "atMs",
     "text"
    ],
    "additionalProperties": true
   }
  },
  "speakers": {
   "type": "array",
   "maxItems": 1000,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "name": {
      "type": [
       "string",
       "null"
      ],
      "minLength": 1,
      "maxLength": 200
     },
     "provenance": {
      "enum": [
       "user",
       "recognised",
       "unnamed",
       "source"
      ]
     },
     "colourIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "id",
     "name",
     "provenance",
     "colourIndex"
    ],
    "additionalProperties": true,
    "allOf": [
     {
      "if": {
       "properties": {
        "provenance": {
         "const": "unnamed"
        }
       }
      },
      "then": {
       "properties": {
        "name": {
         "type": "null"
        }
       }
      },
      "else": {
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    ]
   }
  },
  "transcript": {
   "type": "object",
   "properties": {
    "status": {
     "enum": [
      "none",
      "queued",
      "running",
      "done",
      "failed",
      "damaged"
     ]
    },
    "reference": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "sidecar"
        },
        "file": {
         "const": "transcript.json"
        },
        "format": {
         "const": "cassini.words.v1"
        }
       },
       "required": [
        "kind",
        "file",
        "format"
       ],
       "additionalProperties": true
      },
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "embedded"
        },
        "file": {
         "type": "string",
         "minLength": 1,
         "maxLength": 255,
         "pattern": "^[^/\\\\]+$",
         "not": {
          "enum": [
           ".",
           ".."
          ]
         }
        },
        "transcriptId": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "kind",
        "file"
       ],
       "additionalProperties": true
      }
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ],
     "description": "Speech model that produced the transcript: \"whistle\" or \"<dist id>@<source_sha256>\" (D16). Optional; absent means unknown."
    }
   },
   "required": [
    "status",
    "reference"
   ],
   "additionalProperties": true
  },
  "etaMinutes": {
   "oneOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "error": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9-]*$"
      },
      "action": {
       "type": [
        "string",
        "null"
       ],
       "minLength": 1
      }
     },
     "required": [
      "id",
      "action"
     ],
     "additionalProperties": true
    }
   ]
  },
  "quoteOverride": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "atMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 100000
      }
     },
     "required": [
      "atMs",
      "text"
     ],
     "additionalProperties": true
    }
   ]
  },
  "received": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "originalName": {
       "type": "string",
       "minLength": 1,
       "maxLength": 255,
       "pattern": "^[^/\\\\]+\\.opus$",
       "not": {
        "enum": [
         ".",
         ".."
        ]
       }
      },
      "originalFolderName": {
       "type": "string",
       "minLength": 1,
       "maxLength": 255,
       "pattern": "^[^/\\\\]+$",
       "not": {
        "enum": [
         ".",
         ".."
        ]
       }
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "importedAtMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "required": [
      "originalName",
      "sha256",
      "importedAtMs"
     ],
     "additionalProperties": true
    }
   ]
  }
 },
 "required": [
  "version",
  "revision",
  "id",
  "title",
  "titleSource",
  "notes",
  "speakers",
  "transcript",
  "etaMinutes",
  "error",
  "quoteOverride",
  "received"
 ],
 "additionalProperties": true,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Cassini app-owned meeting metadata, v1",
 "$comment": "Folder prefix and matching UUID, safe nonescaping paths, unique speaker IDs, preservation of unknown members, and cross-process revision/lock rules are additional reader/writer checks in LIBRARY.md. D6.1: etaMinutes may be null while queued/running (shown as 'Transcribing…'). Folder context (not expressible here): a Received-<uuid> folder requires a non-null received object; a Recording-<uuid> folder requires received null. D11.2: provenance 'source' = a name that comes from the capture source (Me, The others); the name is required and non-null, like 'user'.",
 "allOf": [
  {
   "if": {
    "properties": {
     "titleSource": {
      "const": "user"
     }
    }
   },
   "then": {
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "transcript": {
      "properties": {
       "status": {
        "enum": [
         "queued",
         "running"
        ]
       },
       "model": {
        "type": [
         "string",
         "null"
        ],
        "description": "Speech model that produced the transcript: \"whistle\" or \"<dist id>@<source_sha256>\" (D16). Optional; absent means unknown."
       }
      }
     }
    }
   },
   "then": {
    "properties": {
     "etaMinutes": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       },
       {
        "type": "null"
       }
      ]
     }
    }
   },
   "else": {
    "properties": {
     "etaMinutes": {
      "type": "null"
     }
    }
   }
  }
 ]
}
