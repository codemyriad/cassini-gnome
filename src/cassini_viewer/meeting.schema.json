{
 "type": "object",
 "properties": {
  "version": {
   "type": "integer",
   "const": 1
  },
  "revision": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "id": {
   "type": "string",
   "format": "uuid"
  },
  "title": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1,
   "maxLength": 500
  },
  "titleSource": {
   "enum": [
    "meeting-window",
    "user"
   ]
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "atMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "text": {
      "type": "string",
      "maxLength": 100000
     }
    },
    "required": [
     "atMs",
     "text"
    ],
    "additionalProperties": true
   }
  },
  "speakers": {
   "type": "array",
   "maxItems": 1000,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "name": {
      "type": [
       "string",
       "null"
      ],
      "minLength": 1,
      "maxLength": 200
     },
     "provenance": {
      "enum": [
       "user",
       "recognised",
       "unnamed",
       "source"
      ]
     },
     "colourIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "nameCleared": {
      "type": "boolean",
      "const": true,
      "$comment": "D25 amendment (GNOME question). Optional; version stays 1. Written only by an explicit Clear in the Speakers dialog, only with provenance unnamed, and removed when a nonempty name is saved. While present, automatic recognition (AUTO) never names this speaker; SUGGESTED rows (Likely) may still be shown. Readers that don't know it ignore it."
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "$comment": "D48 (R60). Optional; version stays 1. The label this speaker's words were originally produced with, kept verbatim in the writer's language (D47), including for unnamed voices (e.g. 'Parlante 19'). Written when words are produced and when a name is saved or cleared; Merge never changes it. Undo merge restores the manifest label of the merged-away id from it. Readers that don't know it ignore it; it is never a display-time rule."
     }
    },
    "required": [
     "id",
     "name",
     "provenance",
     "colourIndex"
    ],
    "additionalProperties": true,
    "allOf": [
     {
      "if": {
       "properties": {
        "provenance": {
         "const": "unnamed"
        }
       }
      },
      "then": {
       "properties": {
        "name": {
         "type": "null"
        }
       }
      },
      "else": {
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    ]
   }
  },
  "transcript": {
   "type": "object",
   "properties": {
    "status": {
     "enum": [
      "none",
      "queued",
      "running",
      "done",
      "failed",
      "damaged"
     ]
    },
    "reference": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "sidecar"
        },
        "file": {
         "const": "transcript.json"
        },
        "format": {
         "const": "cassini.words.v1"
        }
       },
       "required": [
        "kind",
        "file",
        "format"
       ],
       "additionalProperties": true
      },
      {
       "type": "object",
       "properties": {
        "kind": {
         "const": "embedded"
        },
        "file": {
         "type": "string",
         "minLength": 1,
         "maxLength": 255,
         "pattern": "^[^/\\\\]+$",
         "not": {
          "enum": [
           ".",
           ".."
          ]
         }
        },
        "transcriptId": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "kind",
        "file"
       ],
       "additionalProperties": true
      }
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ],
     "description": "Speech model that produced the transcript: \"whistle\" or \"<dist id>@<source_sha256>\" (D16). Optional; absent means unknown."
    }
   },
   "required": [
    "status",
    "reference"
   ],
   "additionalProperties": true
  },
  "etaMinutes": {
   "oneOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "error": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9-]*$"
      },
      "action": {
       "type": [
        "string",
        "null"
       ],
       "minLength": 1
      }
     },
     "required": [
      "id",
      "action"
     ],
     "additionalProperties": true
    }
   ]
  },
  "quoteOverride": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "atMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 100000
      }
     },
     "required": [
      "atMs",
      "text"
     ],
     "additionalProperties": true
    }
   ]
  },
  "received": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "originalName": {
       "type": "string",
       "minLength": 1,
       "maxLength": 255,
       "pattern": "^[^/\\\\]+\\.opus$",
       "not": {
        "enum": [
         ".",
         ".."
        ]
       }
      },
      "originalFolderName": {
       "type": "string",
       "minLength": 1,
       "maxLength": 255,
       "pattern": "^[^/\\\\]+$",
       "not": {
        "enum": [
         ".",
         ".."
        ]
       }
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "importedAtMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "required": [
      "originalName",
      "sha256",
      "importedAtMs"
     ],
     "additionalProperties": true
    }
   ]
  },
  "speakerMerges": {
   "type": "array",
   "maxItems": 1000,
   "items": {
    "type": "object",
    "properties": {
     "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "into": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     }
    },
    "required": [
     "from",
     "into"
    ],
    "additionalProperties": true
   },
   "$comment": "D24/UX16. Optional; version stays 1. An ordered history: readers apply entries in order and resolve chains (A->B then B->C shows A and B as C) for display, export and Search; transcript.json is never rewritten. Undo merge removes the last entry, so undoing B->C restores A->B. Writers append only when from and into are both speakers visible after resolution and from != into, so no cycle is written. Readers ignore an entry whose from or into is unknown, or that would create a cycle."
  },
  "recordingDetails": {
   "type": "object",
   "description": "Optional D28 Part A design draft facts, app-owned. On-disk version stays 1. Capture session.json and its event contract are unchanged; older readers ignore and preserve this member.",
   "properties": {
    "end": {
     "type": "object",
     "properties": {
      "reason": {
       "enum": [
        "user",
        "callEnded",
        "tabClosed",
        "pageGone",
        "disk",
        "error",
        "appQuit"
       ]
      },
      "atMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991,
       "description": "Final recorded audio endpoint, floor(offset + frames*1000/rate). Optional when timing is unknown; never align from an assumed offset."
      }
     },
     "required": [
      "reason"
     ],
     "additionalProperties": true
    },
    "writingDown": {
     "type": "object",
     "properties": {
      "wallDurationMs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991,
       "description": "Monotonic wall duration of this successful attempt, excluding queue wait and previous interrupted attempts; includes worker setup, recognition, separation, voice extraction and publication before the final done write."
      },
      "resumed": {
       "type": "boolean",
       "description": "True when this attempt resumed a previously queued/running job. Duration covers this attempt only."
      },
      "speechSegments": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991,
       "description": "Optional actual number of planned speech segments, including zero. Absent when the worker did not report it."
      },
      "speakerSeparation": {
       "type": "object",
       "properties": {
        "status": {
         "enum": [
          "completed",
          "partial",
          "skipped",
          "failed"
         ]
        },
        "modelId": {
         "type": "string",
         "minLength": 1,
         "maxLength": 200
        },
        "modelRevision": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "speakersFound": {
         "type": "integer",
         "minimum": 0,
         "maximum": 1000
        },
        "reused": {
         "type": "boolean"
        },
        "reason": {
         "enum": [
          "modelsNotInstalled",
          "modelNotReady",
          "unavailable",
          "notApplicable",
          "tooShort",
          "processingFailed"
         ]
        }
       },
       "required": [
        "status"
       ],
       "additionalProperties": true,
       "allOf": [
        {
         "if": {
          "properties": {
           "status": {
            "enum": [
             "completed",
             "partial"
            ]
           }
          }
         },
         "then": {
          "required": [
           "modelId",
           "modelRevision",
           "speakersFound",
           "reused"
          ]
         }
        },
        {
         "if": {
          "properties": {
           "status": {
            "enum": [
             "skipped",
             "failed"
            ]
           }
          }
         },
         "then": {
          "required": [
           "reason"
          ]
         }
        }
       ]
      }
     },
     "required": [
      "wallDurationMs",
      "resumed",
      "speakerSeparation"
     ],
     "additionalProperties": true
    }
   },
   "additionalProperties": true
  },
  "namePrefix": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}--[0-9]{2}\\.[0-9]{2}-$",
   "description": "S-12 §2: Library v2 file-name prefix, chosen once and kept."
  },
  "namePrefixSource": {
   "enum": [
    "recorded",
    "legacy-device-tz",
    "date-tag",
    "import-time"
   ],
   "description": "S-12 §11 Q12: where namePrefix came from."
  },
  "published": {
   "type": "boolean",
   "description": "S-12 §4.6: true once the meeting's Cassini file was durably published."
  }
 },
 "required": [
  "version",
  "revision",
  "id",
  "title",
  "titleSource",
  "notes",
  "speakers",
  "transcript",
  "etaMinutes",
  "error",
  "quoteOverride",
  "received"
 ],
 "additionalProperties": true,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Cassini app-owned meeting metadata, v1",
 "$comment": "Folder prefix and matching UUID, safe nonescaping paths, unique speaker IDs, preservation of unknown members, and cross-process revision/lock rules are additional reader/writer checks in LIBRARY.md. D6.1: etaMinutes may be null while queued/running (shown as 'Transcribing…'). Folder context (not expressible here): a Received-<uuid> folder requires a non-null received object; a Recording-<uuid> folder requires received null. D11.2: provenance 'source' = a name that comes from the capture source (Me, The others); the name is required and non-null, like 'user'.",
 "allOf": [
  {
   "if": {
    "properties": {
     "titleSource": {
      "const": "user"
     }
    }
   },
   "then": {
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "transcript": {
      "properties": {
       "status": {
        "enum": [
         "queued",
         "running"
        ]
       },
       "model": {
        "type": [
         "string",
         "null"
        ],
        "description": "Speech model that produced the transcript: \"whistle\" or \"<dist id>@<source_sha256>\" (D16). Optional; absent means unknown."
       }
      }
     }
    }
   },
   "then": {
    "properties": {
     "etaMinutes": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       },
       {
        "type": "null"
       }
      ]
     }
    }
   },
   "else": {
    "properties": {
     "etaMinutes": {
      "type": "null"
     }
    }
   }
  }
 ]
}
