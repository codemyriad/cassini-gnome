<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later
-->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Browser Meetings…</attribute>
        <attribute name="action">app.browser-meetings</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Record Meeting…</attribute>
        <attribute name="action">app.record</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_New Window</attribute>
        <attribute name="action">app.new-window</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Open…</attribute>
        <attribute name="action">app.open</attribute>
      </item>
    </section>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">_Export Transcript</attribute>
        <section>
          <item>
            <attribute name="label" translatable="yes">As _Text…</attribute>
            <attribute name="action">win.export</attribute>
            <attribute name="target">txt</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">As _Subtitles (WebVTT)…</attribute>
            <attribute name="action">win.export</attribute>
            <attribute name="target">vtt</attribute>
          </item>
        </section>
      </submenu>
      <item>
        <attribute name="label" translatable="yes">Show in _Files</attribute>
        <attribute name="action">win.show-in-files</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Cassini</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <menu id="export_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">As _Text…</attribute>
        <attribute name="action">win.export</attribute>
        <attribute name="target">txt</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">As _Subtitles (WebVTT)…</attribute>
        <attribute name="action">win.export</attribute>
        <attribute name="target">vtt</attribute>
      </item>
    </section>
  </menu>
  <menu id="rate_menu">
    <section>
      <item>
        <attribute name="label">0.75×</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">0.75</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Normal</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">1</attribute>
      </item>
      <item>
        <attribute name="label">1.25×</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">1.25</attribute>
      </item>
      <item>
        <attribute name="label">1.5×</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">1.5</attribute>
      </item>
      <item>
        <attribute name="label">1.75×</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">1.75</attribute>
      </item>
      <item>
        <attribute name="label">2×</attribute>
        <attribute name="action">win.rate</attribute>
        <attribute name="target">2</attribute>
      </item>
    </section>
  </menu>
  <template class="CassiniWindow" parent="AdwApplicationWindow">
    <property name="default-width">1200</property>
    <property name="default-height">780</property>
    <property name="width-request">360</property>
    <property name="height-request">400</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 1040sp</condition>
        <setter object="inspector_split" property="collapsed">True</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 760sp</condition>
        <setter object="inspector_split" property="collapsed">True</setter>
        <setter object="sidebar_split" property="collapsed">True</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint" id="narrow_breakpoint">
        <condition>max-width: 520sp</condition>
        <setter object="inspector_split" property="collapsed">True</setter>
        <setter object="sidebar_split" property="collapsed">True</setter>
        <setter object="details_box" property="visible">False</setter>
        <setter object="follow_label" property="visible">False</setter>
        <setter object="title_stack" property="visible-child-name">title</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="GtkStack" id="main_stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <child type="end">
                          <object class="GtkMenuButton">
                            <property name="icon-name">open-menu-symbolic</property>
                            <property name="menu-model">primary_menu</property>
                            <property name="primary">True</property>
                            <property name="tooltip-text" translatable="yes">Main Menu</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwStatusPage" id="empty_page">
                        <property name="title" translatable="yes">Open a Meeting</property>
                        <property name="description" translatable="yes">Play a meeting recording and read along with the transcript stored inside it. Drop an .opus file here or choose one.</property>
                        <property name="child">
                          <object class="GtkButton">
                            <property name="label" translatable="yes">_Open…</property>
                            <property name="use-underline">True</property>
                            <property name="halign">center</property>
                            <property name="action-name">app.open</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar"/>
                    </child>
                    <property name="content">
                      <object class="AdwSpinner">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="width-request">48</property>
                        <property name="height-request">48</property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">meeting</property>
                <property name="child">
                  <object class="AdwOverlaySplitView" id="inspector_split">
                    <property name="sidebar-position">end</property>
                    <property name="min-sidebar-width">280</property>
                    <property name="max-sidebar-width">340</property>
                    <property name="sidebar">
                      <object class="AdwToolbarView">
                        <child type="top">
                          <object class="AdwHeaderBar">
                            <property name="title-widget">
                              <object class="AdwWindowTitle">
                                <property name="title" translatable="yes">Properties</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <property name="content">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="child">
                              <object class="GtkBox" id="properties_box">
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">18</property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="AdwOverlaySplitView" id="sidebar_split">
                        <property name="min-sidebar-width">220</property>
                        <property name="max-sidebar-width">280</property>
                        <property name="sidebar">
                          <object class="AdwToolbarView">
                            <child type="top">
                              <object class="AdwHeaderBar">
                                <property name="title-widget">
                                  <object class="AdwWindowTitle">
                                    <property name="title" translatable="yes">Cassini</property>
                                  </object>
                                </property>
                                <child type="end">
                                  <object class="GtkMenuButton">
                                    <property name="icon-name">open-menu-symbolic</property>
                                    <property name="menu-model">primary_menu</property>
                                    <property name="primary">True</property>
                                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <property name="content">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="GtkBox" id="transcript_chooser">
                                        <property name="orientation">vertical</property>
                                        <property name="visible">False</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">6</property>
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Transcript</property>
                                            <property name="xalign">0</property>
                                            <property name="margin-start">6</property>
                                            <property name="margin-top">6</property>
                                            <style>
                                              <class name="caption-heading"/>
                                              <class name="dimmed"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkDropDown" id="transcript_dropdown">
                                            <accessibility>
                                              <property name="label" translatable="yes">Transcript</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="speakers_heading">
                                        <property name="label" translatable="yes">Speakers</property>
                                        <property name="xalign">0</property>
                                        <property name="margin-start">18</property>
                                        <property name="margin-top">12</property>
                                        <property name="margin-bottom">6</property>
                                        <style>
                                          <class name="caption-heading"/>
                                          <class name="dimmed"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkListBox" id="speakers_list">
                                        <property name="selection-mode">none</property>
                                        <accessibility>
                                          <property name="label" translatable="yes">Speakers</property>
                                        </accessibility>
                                        <style>
                                          <class name="navigation-sidebar"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                            <child type="bottom">
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <property name="margin-start">18</property>
                                <property name="margin-end">12</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">12</property>
                                <style>
                                  <class name="dimmed"/>
                                </style>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">audio-x-generic-symbolic</property>
                                    <property name="accessible-role">presentation</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="file_label">
                                    <property name="xalign">0</property>
                                    <property name="ellipsize">middle</property>
                                    <property name="hexpand">True</property>
                                    <style>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="content">
                          <object class="AdwToolbarView">
                            <property name="bottom-bar-style">raised</property>
                            <child type="top">
                              <object class="AdwHeaderBar">
                                <child type="start">
                                  <object class="GtkToggleButton" id="sidebar_button">
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                                    <property name="action-name">win.show-sidebar</property>
                                  </object>
                                </child>
                                <property name="title-widget">
                                  <object class="GtkStack" id="title_stack">
                                    <property name="hhomogeneous">False</property>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">switcher</property>
                                        <property name="child">
                                          <object class="AdwViewSwitcher">
                                            <property name="policy">wide</property>
                                            <property name="stack">view_stack</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">title</property>
                                        <property name="child">
                                          <object class="AdwWindowTitle" id="window_title"/>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <child type="end">
                                  <object class="GtkToggleButton" id="inspector_button">
                                    <property name="icon-name">sidebar-show-right-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Properties</property>
                                    <property name="action-name">win.show-properties</property>
                                  </object>
                                </child>
                                <child type="end">
                                  <object class="GtkToggleButton" id="search_button">
                                    <property name="icon-name">edit-find-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Search Transcript</property>
                                    <property name="action-name">win.search</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="top">
                              <object class="GtkSearchBar" id="search_bar">
                                <property name="child">
                                  <object class="AdwClamp">
                                    <property name="maximum-size">440</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkSearchEntry" id="search_entry">
                                            <property name="hexpand">True</property>
                                            <property name="placeholder-text" translatable="yes">Search transcript</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="match_label">
                                            <property name="width-chars">8</property>
                                            <style>
                                              <class name="dimmed"/>
                                              <class name="numeric"/>
                                              <class name="caption"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">go-up-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Previous Match</property>
                                            <property name="action-name">win.previous-match</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">go-down-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Next Match</property>
                                            <property name="action-name">win.next-match</property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child type="top">
                              <object class="AdwBanner" id="banner"/>
                            </child>
                            <property name="content">
                              <object class="AdwViewStack" id="view_stack">
                                <child>
                                  <object class="AdwViewStackPage">
                                    <property name="name">transcript</property>
                                    <property name="title" translatable="yes">_Transcript</property>
                                    <property name="use-underline">True</property>
                                    <property name="icon-name">view-list-symbolic</property>
                                    <property name="child">
                                      <object class="GtkStack" id="transcript_stack">
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">list</property>
                                            <property name="child">
                                              <object class="GtkScrolledWindow" id="transcript_scroller">
                                                <property name="hscrollbar-policy">never</property>
                                                <property name="vexpand">True</property>
                                                <property name="child">
                                                  <object class="AdwClampScrollable">
                                                    <property name="maximum-size">760</property>
                                                    <property name="tightening-threshold">560</property>
                                                    <property name="child">
                                                      <object class="GtkListView" id="transcript_list">
                                                        <property name="tab-behavior">item</property>
                                                        <accessibility>
                                                          <property name="label" translatable="yes">Transcript</property>
                                                        </accessibility>
                                                        <style>
                                                          <class name="transcript"/>
                                                        </style>
                                                      </object>
                                                    </property>
                                                  </object>
                                                </property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">status</property>
                                            <property name="child">
                                              <object class="AdwStatusPage" id="transcript_status"/>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwViewStackPage" id="summary_page">
                                    <property name="name">summary</property>
                                    <property name="title" translatable="yes">_Summary</property>
                                    <property name="use-underline">True</property>
                                    <property name="icon-name">view-list-bullet-symbolic</property>
                                    <property name="child">
                                      <object class="GtkScrolledWindow">
                                        <property name="hscrollbar-policy">never</property>
                                        <property name="child">
                                          <object class="AdwClamp">
                                            <property name="maximum-size">640</property>
                                            <property name="child">
                                              <object class="GtkBox" id="summary_box">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">12</property>
                                                <property name="margin-top">30</property>
                                                <property name="margin-bottom">40</property>
                                                <property name="margin-start">18</property>
                                                <property name="margin-end">18</property>
                                              </object>
                                            </property>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <child type="bottom">
                              <object class="AdwViewSwitcherBar" id="switcher_bar">
                                <property name="stack">view_stack</property>
                              </object>
                            </child>
                            <child type="bottom">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">4</property>
                                <property name="margin-start">16</property>
                                <property name="margin-end">16</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">10</property>
                                <style>
                                  <class name="player-bar"/>
                                </style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel" id="elapsed_label">
                                        <property name="label">0:00</property>
                                        <property name="width-chars">5</property>
                                        <property name="xalign">0</property>
                                        <style>
                                          <class name="numeric"/>
                                          <class name="caption"/>
                                          <class name="dimmed"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScale" id="position_scale">
                                        <property name="hexpand">True</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment" id="position_adjustment">
                                            <property name="upper">1</property>
                                            <property name="step-increment">5000</property>
                                            <property name="page-increment">15000</property>
                                          </object>
                                        </property>
                                        <accessibility>
                                          <property name="label" translatable="yes">Playback Position</property>
                                        </accessibility>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="remaining_label">
                                        <property name="label">0:00</property>
                                        <property name="width-chars">6</property>
                                        <property name="xalign">1</property>
                                        <style>
                                          <class name="numeric"/>
                                          <class name="caption"/>
                                          <class name="dimmed"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCenterBox">
                                    <property name="start-widget">
                                      <object class="GtkBox" id="details_box">
                                        <property name="orientation">vertical</property>
                                        <property name="valign">center</property>
                                        <property name="width-request">120</property>
                                        <child>
                                          <object class="GtkLabel" id="title_label">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">end</property>
                                            <style>
                                              <class name="heading"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="subtitle_label">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">end</property>
                                            <style>
                                              <class name="caption"/>
                                              <class name="dimmed"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <property name="center-widget">
                                      <object class="GtkBox">
                                        <property name="spacing">10</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">skip-backward-15-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Back 15 Seconds</property>
                                            <property name="action-name">win.skip-back</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="circular"/>
                                              <class name="flat"/>
                                              <class name="skip"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="play_button">
                                            <property name="icon-name">media-playback-start-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Play</property>
                                            <property name="action-name">win.play-pause</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="circular"/>
                                              <class name="suggested-action"/>
                                              <class name="play"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">skip-forward-15-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Forward 15 Seconds</property>
                                            <property name="action-name">win.skip-forward</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="circular"/>
                                              <class name="flat"/>
                                              <class name="skip"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <property name="end-widget">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <property name="halign">end</property>
                                        <property name="valign">center</property>
                                        <child>
                                          <object class="GtkMenuButton" id="rate_button">
                                            <property name="label">1×</property>
                                            <property name="menu-model">rate_menu</property>
                                            <property name="always-show-arrow">False</property>
                                            <property name="tooltip-text" translatable="yes">Playback Speed</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="numeric"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="follow_button">
                                            <property name="action-name">win.follow-along</property>
                                            <property name="tooltip-text" translatable="yes">Keep the Spoken Word in View</property>
                                            <property name="child">
                                              <object class="GtkBox">
                                                <property name="spacing">6</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">find-location-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel" id="follow_label">
                                                    <property name="label" translatable="yes">_Follow Along</property>
                                                    <property name="use-underline">True</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
