    {
      "id": "018-oversize-opustags",
      "file": "opus/018-oversize-opustags.opus",
      "bytes": 68450,
      "sha256": "199e9b964f3aa660e98ffe18301bc63fa3dba9d58511f718c598388670558036",
      "derivedFrom": "001-minimal-v1",
      "profiles": [
        "metadata",
        "full"
      ],
      "summary": "A 68,032-octet OpusTags packet: a 48 KB incompressible attachments[] entry pushes the manifest to 16 chunks. In ASCII order 25 of 49 comments fall past octet 61,440, among them CASSINI_PAYLOAD_CHUNK_COUNT and CASSINI_PAYLOAD_SHA256.",
      "rationale": "RFC 7845 5.2 lets an implementation ignore comments not fully inside the first 61,440 octets. A reader that exercises that MAY sees CASSINI_FORMAT and nothing it needs to act on it.",
      "spec": [
        "RFC7845#section-5.2",
        "SPEC.md#chunk-sets"
      ],
      "decides": "comment-header-size",
      "expect": {
        "classification": "cassini",
        "payloadTrust": "verified",
        "sameContentAs": "001-minimal-v1",
        "state": "unverified"
      },
      "alsoAcceptable": [
        {
          "classification": "damaged-metadata",
          "errors": [
            {
              "code": "comment-header-truncated"
            }
          ],
          "state": "invalid-cassini-metadata"
        }
      ],
      "note": "MUST NOT be classified plain-audio: CASSINI_FORMAT is inside the window."
    },
