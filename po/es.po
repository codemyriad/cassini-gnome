msgid "Show the speakers sidebar"
msgstr "Mostrar la barra lateral de hablantes"

msgid "Show the properties pane"
msgstr "Mostrar el panel de propiedades"

msgid "Follow along"
msgstr "Seguir la reproducción"

msgid "Keep the word being spoken in view while playing."
msgstr "Mantén visible la palabra pronunciada durante la reproducción."

