msgid "@APP_NAME@"
msgstr "@APP_NAME@"

msgid "meeting;transcript;recording;opus;captions;speech;"
msgstr "reunión;transcripción;grabación;opus;subtítulos;voz;"

msgid "Meeting Recorder"
msgstr "Grabador de reuniones"

msgid "Record meetings and write them down on this computer"
msgstr "Graba tus reuniones y transcríbelas en este equipo"

msgid "Record meetings and write them down"
msgstr "Graba y transcribe tus reuniones"

msgid "Cassini records your meetings and writes them down on this computer, offline. There is no account and nothing is uploaded."
msgstr "Cassini graba tus reuniones y las transcribe en este equipo, sin conexión. No necesitas una cuenta y no se sube nada."

msgid "Record your microphone and this computer’s sound, or calls in your browser with each person kept apart"
msgstr "Graba tu micrófono y el sonido de este equipo, o las llamadas en tu navegador con cada persona por separado"

msgid "Write meetings down with the included Whistle model or the optional Parakeet Ultra"
msgstr "Transcribe las reuniones con el modelo Whistle incluido o con Parakeet Ultra opcional"

msgid "Tell speakers apart, name them, and recognise saved voices in later meetings"
msgstr "Distingue a los hablantes, ponles nombre y reconoce las voces guardadas en las siguientes reuniones"

msgid "Search every meeting by phrase, speaker or date"
msgstr "Busca en todas las reuniones por frase, hablante o fecha"

msgid "Import audio files and export meetings as Cassini files, Markdown, text or subtitles"
msgstr "Importa archivos de audio y exporta las reuniones como archivos Cassini, Markdown, texto o subtítulos"

msgid "Cassini files are ordinary Ogg Opus audio files that carry their transcript, speakers and notes inside, and play in any audio player."
msgstr "Los archivos Cassini son archivos de audio Ogg Opus normales que llevan dentro su transcripción, sus hablantes y sus notas, y se reproducen en cualquier reproductor de audio."

msgid "The Library with sample meetings"
msgstr "La Biblioteca con reuniones de ejemplo"

msgid "A sample meeting being written down while its audio plays"
msgstr "Una reunión de ejemplo transcribiéndose mientras se reproduce su audio"

msgid "Follow the transcript as it plays, with the spoken word highlighted"
msgstr "Sigue la transcripción durante la reproducción, con la palabra pronunciada resaltada"

msgid "Click any word to play from there"
msgstr "Haz clic en cualquier palabra para reproducir desde ahí"

msgid "Codemyriad"
msgstr "Codemyriad"

msgid "Keep recordings and received meetings in the Library, follow their transcripts, search across meetings, and import or export audio and transcripts."
msgstr "Conserva las grabaciones y las reuniones recibidas en la biblioteca, sigue sus transcripciones, busca en todas las reuniones e importa o exporta audio y transcripciones."

msgid "Record browser meetings independently, choose what is recorded, and set up the companion in native packages or Flatpak"
msgstr "Graba reuniones en el navegador de forma independiente, elige qué se graba y configura la extensión en paquetes nativos o Flatpak"

msgid "Write meetings down locally with bundled Whistle or optional Parakeet Ultra"
msgstr "Transcribe reuniones en este equipo con Whistle incluido o Parakeet Ultra opcional"

msgid "Tell speakers apart, name and merge speakers, and remember saved voices locally"
msgstr "Distingue hablantes, ponles nombre y fusiónalos, y recuerda las voces guardadas en este equipo"

msgid "Keep audio aligned through input interruptions without adding silence for gradual clock drift"
msgstr "Mantén el audio alineado durante las interrupciones de entrada sin añadir silencio por la deriva gradual del reloj"

msgid "Record meetings: the microphone and desktop audio, and browser meetings source by source through the Cassini companion extension. Cassini now names missing libraries and plugins at startup instead of failing."
msgstr "Graba reuniones: el micrófono y el audio del equipo, y las reuniones en el navegador fuente por fuente con la extensión de Cassini. Al iniciar, Cassini ahora indica las bibliotecas y los complementos que faltan en lugar de fallar."

msgid "Fix transcript-click crashes and label sizing warnings. Keep participants visible, rejoin interrupted speech with inline interjections, and preserve interjections in exports."
msgstr "Corrige cierres al hacer clic en la transcripción y avisos de tamaño de etiquetas. Mantiene visibles a los participantes, une el habla interrumpida con interjecciones intercaladas y conserva estas en las exportaciones."

msgid "First release."
msgstr "Primera versión."

msgid "Speech model for new jobs"
msgstr "Modelo de voz para nuevas transcripciones"

msgid "Global recording shortcut explicitly enabled"
msgstr "Atajo global de grabación activado explícitamente"

msgid "Desktop recording shortcut description"
msgstr "Descripción del atajo de grabación del escritorio"

msgid "Browser companion has connected before"
msgstr "La extensión del navegador ya se ha conectado"

msgid "Windowless automatic recording notification shown"
msgstr "Notificación de grabación automática sin ventana mostrada"

msgid "Skip recording introduction"
msgstr "Omitir la introducción a la grabación"

msgid "Last folder selected for export"
msgstr "Última carpeta elegida para exportar"

msgid "Companion card dismissed"
msgstr "Tarjeta de la extensión cerrada"

