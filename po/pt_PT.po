msgstr "Altura da janela"

msgid "Window maximized"
msgstr "Janela maximizada"

msgid "Show the speakers sidebar"
msgstr "Mostrar a barra lateral de oradores"

msgid "Show the properties pane"
msgstr "Mostrar o painel de propriedades"

msgid "Follow along"
msgstr "Acompanhar a leitura"

msgid "Keep the word being spoken in view while playing."
msgstr "Mantenha a palavra pronunciada visível durante a reprodução."

