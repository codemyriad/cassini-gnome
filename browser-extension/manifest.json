{
  "manifest_version": 3,
  "key": "",
  "name": "Cassini Browser Companion",
  "version": "0.2.24",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Connect browser meeting audio to Cassini and check meeting detection and connection status.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "offscreen",
    "tabCapture",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Cassini browser companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "capture.js",
        "pcm-worklet.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Open Cassini browser companion"
    }
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
