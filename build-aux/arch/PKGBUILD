# Maintainer: Silvio Tomatis <silviot@gmail.com>
#
# Builds Cassini Viewer from a tarball of the local source tree, staged next
# to this file by build-aux/arch/build.sh. Keep pkgver equal to the version
# in meson.build; build.sh refuses to build when they differ.
#
# For the AUR, build from the release tag instead:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
#   sha256sums=('...')   # fill in with: updpkgsums
#   _srcdir=cassini-gnome-$pkgver      # GitHub names the top directory after the repo

pkgname=cassini-viewer
pkgver=0.2.0
pkgrel=1
pkgdesc='Record meetings and read along with their transcripts in the Cassini portable meeting format'
# The offline writing-down engine is a pinned glibc x86_64 binary.
arch=(x86_64)
url='https://github.com/codemyriad/cassini-gnome'
license=(GPL-3.0-or-later Apache-2.0 MIT)
depends=(
  # The private ONNX Runtime (source=) is the wheel for this Python's ABI,
  # cp314: move the wheel and these together when Arch moves to a new Python.
  'python>=3.14'
  'python<3.15'
  python-gobject
  'gtk4>=4.18'
  'libadwaita>=1.8'
  gstreamer
  gst-plugins-base
  gst-plugins-good
  # Writing meetings down offline. ONNX Runtime is not a dependency: the
  # package carries the pinned upstream wheel, see source=.
  python-numpy
  glibc
  gcc-libs
)
makedepends=(meson gcc)
checkdepends=(python-pytest python-jsonschema python-rfc3339-validator appstream desktop-file-utils)
# The PulseAudio sink (pulsesink) ships in gst-plugins-good, already a dependency.
optdepends=('gst-plugin-pipewire: audio output through PipeWire')
# The app checks every file of the bundle against its pinned sha256 before it
# loads anything, and the private ONNX Runtime against its wheel's RECORD,
# so makepkg must not strip them or split debug info out.
options=(!strip !debug)
# The writing-down bundle and the ONNX Runtime wheel for Python 3.14, pinned
# in whistle/pins.json (keep these equal to it; tests/test_packaging_pins.py
# checks). The build never downloads: meson runs whistle/fetch.py --offline
# on these files, checking every sha256 again.
source=("$pkgname-$pkgver.tar.gz"
        'whistle.cact::https://huggingface.co/Cactus-Compute/whistle/resolve/ca5287601bef25af26dcf2e1b2bdc0843a7c19e5/whistle.cact'
        'engine.whl::https://huggingface.co/Cactus-Compute/needle3/resolve/93e88ede867e4311c39151285e74df513e4b835b/python/cactus_needle-3.3.0-py3-none-manylinux2014_x86_64.whl'
        'wrapper.whl::https://files.pythonhosted.org/packages/e7/13/5f3a1c20b6643e83cd3f55c866217a0d539c343aaaf7de5253ce08ac16bf/cactus_needle-3.2.0-py3-none-any.whl'
        'silero_vad.onnx::https://raw.githubusercontent.com/snakers4/silero-vad/7e30209a3e901f9842f81b225f3e93d8199902b1/src/silero_vad/data/silero_vad.onnx'
        'https://files.pythonhosted.org/packages/30/2e/5c6ec7e26a097e97ee70f2dee68b8ca4d9d26701f2f33c3f8ab585cb89fe/onnxruntime-1.31.0-cp314-cp314-manylinux_2_28_x86_64.whl'
        'libonnxruntime.so::https://raw.githubusercontent.com/codemyriad/sherpa-onnx-go-linux/03a94bc4bfc1e1bd455cd2fa62b93e8d73817a85/lib/x86_64-unknown-linux-gnu/libonnxruntime.so'
        'libsherpa-onnx-c-api.so::https://raw.githubusercontent.com/codemyriad/sherpa-onnx-go-linux/03a94bc4bfc1e1bd455cd2fa62b93e8d73817a85/lib/x86_64-unknown-linux-gnu/libsherpa-onnx-c-api.so'
        'CASSINI-SHA256SUMS::https://raw.githubusercontent.com/codemyriad/sherpa-onnx-go-linux/03a94bc4bfc1e1bd455cd2fa62b93e8d73817a85/CASSINI-SHA256SUMS')
noextract=(engine.whl wrapper.whl onnxruntime-1.31.0-cp314-cp314-manylinux_2_28_x86_64.whl)
sha256sums=('SKIP'
            'b6e02f048568ac5d01a2042556c658061e699acbc0aa2a1439f52f3d461dffeb'
            '33717a889ecc8d8bb59a1ba3982635176a66479cac61297242b86b9a1c94dc5b'
            '613b3401ad4e78b738b1bfb8fa1548ed5dd61abafe218fe0dc2cb7bf534e6b9a'
            '1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3'
            'e4efa4a1a0bb0b5173c6a3292c181d518b8323f9d56e978635d0c09d38c94d1a'
            'c85f471e1bd5059a4556038f7f5288fa41141647613688452ae7de4879150903'
            '9f461c6b5bb2c57567971cde1fc6fd7762a395427f4063d0ee9b8611c3e1fddc'
            'fa59734ebf92a17c5edc6793b74c8f8e0a184df640597d62f1208ceb0d66ca78')
_srcdir=$pkgname-$pkgver

build() {
  arch-meson "$_srcdir" build -Dwhistle=enabled -Dwhistle_cache="$srcdir" -Dsherpa=enabled -Dsherpa_cache="$srcdir"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  python "$_srcdir/whistle/verify.py" "$pkgdir/usr/share/$pkgname/whistle"
  python "$_srcdir/whistle/verify.py" --onnxruntime "$pkgdir/usr/lib/$pkgname/python"
  python "$_srcdir/sherpa/fetch.py" --cache "$srcdir" --verify "$pkgdir/usr/lib/$pkgname/sherpa"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/sherpa" \
    "$_srcdir/sherpa/NOTICE.md" "$_srcdir/sherpa/LICENSE-sherpa-Apache-2.0.txt" "$_srcdir/sherpa/LICENSE-ONNXRuntime-MIT.txt"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$_srcdir/whistle/NOTICE.md" "$_srcdir/whistle/LICENSE-Apache-2.0.txt" "$_srcdir/whistle/LICENSE-Silero-MIT.txt" \
    "$_srcdir/whistle/LICENSE-ONNXRuntime-MIT.txt"
}
