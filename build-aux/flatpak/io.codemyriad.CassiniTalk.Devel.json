{
    "id": "io.codemyriad.CassiniTalk.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "cassini-talk",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=xdg-music/Cassini:create",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=com.gocassini.Viewer.Devel"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "python3-numpy",
            "only-arches": [
                "x86_64"
            ],
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true
            },
            "build-commands": [
                "pip3 install --no-index --no-deps --no-build-isolation --no-compile --prefix=${FLATPAK_DEST} numpy-2.5.4-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                "python3 -c 'import numpy; print(\"numpy\", numpy.__version__)'"
            ],
            "cleanup": [
                "/bin/f2py",
                "/bin/numpy-config"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/da/24/3bd070f3269dc609d8f26b2643f62ef91bb415841c0b294805aaf7fe06da/numpy-2.5.4-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "sha256": "6ffa07666f8da0eef81d149934a626d0d95fbd6838432a33e66245423a9062c0"
                }
            ]
        },
        {
            "name": "cassini-talk",
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=development"
            ],
            "run-tests": true,
            "build-options": {
                "no-debuginfo": true,
                "arch": {
                    "x86_64": {
                        "config-opts": [
                            "-Dwhistle=enabled",
                            "-Dwhistle_cache=.whistle-cache",
                            "-Dsherpa=enabled",
                            "-Dsherpa_cache=.sherpa-cache"
                        ]
                    }
                }
            },
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        ".git",
                        ".venv",
                        ".flatpak-builder",
                        "_flatpak",
                        "repo",
                        "dist",
                        "build",
                        "builddir",
                        "_build",
                        "_build-system",
                        "_build-shot",
                        "_install",
                        "_install-shot",
                        "ux-artifacts",
                        ".pytest_cache",
                        ".ruff_cache",
                        "debian/.debhelper",
                        "debian/cassini-viewer",
                        "tests/recording/node_modules",
                        "tests/recording/artifacts",
                        ".whistle-cache",
                        ".sherpa-cache",
                        "debian/cassini-talk",
                        "debian/tmp"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://huggingface.co/Cactus-Compute/whistle/resolve/ca5287601bef25af26dcf2e1b2bdc0843a7c19e5/whistle.cact",
                    "sha256": "b6e02f048568ac5d01a2042556c658061e699acbc0aa2a1439f52f3d461dffeb",
                    "dest": ".whistle-cache",
                    "dest-filename": "whistle.cact",
                    "only-arches": [
