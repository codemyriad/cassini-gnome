{
    "id": "com.gocassini.Viewer.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "cassini-viewer",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "cassini-viewer",
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=development"
            ],
            "run-tests": true,
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        ".git",
                        ".venv",
                        ".flatpak-builder",
                        "_flatpak",
                        "repo",
                        "dist",
                        "build",
                        "builddir",
                        "_build",
                        "_build-system",
                        "_build-shot",
                        "_install",
                        "_install-shot",
                        "ux-artifacts",
                        ".pytest_cache",
                        ".ruff_cache",
                        "debian/.debhelper",
                        "debian/cassini-viewer",
                        "tests/recording/node_modules",
                        "tests/recording/artifacts"
                    ]
                }
            ]
        }
    ]
}
