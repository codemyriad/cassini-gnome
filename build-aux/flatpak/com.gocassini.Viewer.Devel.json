{
    "id": "com.gocassini.Viewer.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "cassini-viewer",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "python3-numpy-onnxruntime",
            "only-arches": [
                "x86_64"
            ],
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true
            },
            "build-commands": [
                "pip3 install --no-index --no-deps --no-build-isolation --no-compile --prefix=${FLATPAK_DEST} numpy-2.5.4-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl onnxruntime-1.31.0-cp313-cp313-manylinux_2_28_x86_64.whl",
                "python3 -c 'import numpy, onnxruntime; assert onnxruntime.__version__ == \"1.31.0\", onnxruntime.__version__; print(\"numpy\", numpy.__version__, \"onnxruntime\", onnxruntime.__version__, onnxruntime.get_available_providers())'"
            ],
            "cleanup": [
                "/bin/f2py",
                "/bin/numpy-config",
                "/bin/onnxruntime_test",
                "/lib/python3.13/site-packages/onnxruntime/transformers",
                "/lib/python3.13/site-packages/onnxruntime/quantization",
                "/lib/python3.13/site-packages/onnxruntime/tools"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/da/24/3bd070f3269dc609d8f26b2643f62ef91bb415841c0b294805aaf7fe06da/numpy-2.5.4-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "sha256": "6ffa07666f8da0eef81d149934a626d0d95fbd6838432a33e66245423a9062c0"
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/0d/ac/67ebbaab4b3083f2a6b27ee6c4aa400c7f8d6c72b5499aac7e4cd6ba74f5/onnxruntime-1.31.0-cp313-cp313-manylinux_2_28_x86_64.whl",
                    "sha256": "37fd78cee5160c7a43a1730ccb3682ffd880af9c9e80385d625c0c2f8b125809"
                }
            ]
        },
        {
            "name": "cassini-viewer",
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=development"
            ],
            "run-tests": true,
            "build-options": {
                "no-debuginfo": true,
                "arch": {
                    "x86_64": {
                        "config-opts": [
                            "-Dwhistle=enabled",
                            "-Dwhistle_cache=.whistle-cache"
                        ]
                    }
                }
            },
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        ".git",
                        ".venv",
                        ".flatpak-builder",
                        "_flatpak",
                        "repo",
                        "dist",
                        "build",
                        "builddir",
                        "_build",
                        "_build-system",
                        "_build-shot",
                        "_install",
                        "_install-shot",
                        "ux-artifacts",
                        ".pytest_cache",
                        ".ruff_cache",
                        "debian/.debhelper",
                        "debian/cassini-viewer",
                        "tests/recording/node_modules",
                        "tests/recording/artifacts",
                        ".whistle-cache"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://huggingface.co/Cactus-Compute/whistle/resolve/ca5287601bef25af26dcf2e1b2bdc0843a7c19e5/whistle.cact",
                    "sha256": "b6e02f048568ac5d01a2042556c658061e699acbc0aa2a1439f52f3d461dffeb",
                    "dest": ".whistle-cache",
                    "dest-filename": "whistle.cact",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://huggingface.co/Cactus-Compute/needle3/resolve/93e88ede867e4311c39151285e74df513e4b835b/python/cactus_needle-3.3.0-py3-none-manylinux2014_x86_64.whl",
                    "sha256": "33717a889ecc8d8bb59a1ba3982635176a66479cac61297242b86b9a1c94dc5b",
                    "dest": ".whistle-cache",
                    "dest-filename": "engine.whl",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/e7/13/5f3a1c20b6643e83cd3f55c866217a0d539c343aaaf7de5253ce08ac16bf/cactus_needle-3.2.0-py3-none-any.whl",
                    "sha256": "613b3401ad4e78b738b1bfb8fa1548ed5dd61abafe218fe0dc2cb7bf534e6b9a",
                    "dest": ".whistle-cache",
                    "dest-filename": "wrapper.whl",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/snakers4/silero-vad/7e30209a3e901f9842f81b225f3e93d8199902b1/src/silero_vad/data/silero_vad.onnx",
                    "sha256": "1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3",
                    "dest": ".whistle-cache",
                    "dest-filename": "silero_vad.onnx",
                    "only-arches": [
                        "x86_64"
                    ]
                }
            ]
        }
    ]
}
