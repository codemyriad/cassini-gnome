<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Codemyriad OÜ -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later AND Apache-2.0 AND MIT AND Unicode-3.0</project_license>

  <name translate="no">@APP_NAME@</name>
  <summary>Read along with meeting recordings</summary>
  <description>
    <p>
      Cassini plays meeting recordings in the Cassini portable meeting format:
      ordinary Ogg Opus files that carry their own word-by-word transcript,
      speaker names and summary.
    </p>
    <ul>
      <li>Follow the transcript as it plays, with the spoken word highlighted</li>
      <li>Click any word to play from there</li>
      <li>See participants and who is speaking, and switch between transcripts</li>
      <li>Search the transcript</li>
      <li>Read the meeting summary and jump to its topics</li>
      <li>Check that the audio still matches the transcript recorded with it</li>
      <li>Export the transcript as text or WebVTT subtitles</li>
    </ul>
    <p>
      Files without a transcript play like in any other audio player.
    </p>
  </description>

  <developer id="io.codemyriad">
    <name>Codemyriad</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">cassini-talk</translation>

  <url type="homepage">https://github.com/codemyriad/cassini-gnome</url>
  <url type="bugtracker">https://github.com/codemyriad/cassini-gnome/issues</url>
  <url type="vcs-browser">https://github.com/codemyriad/cassini-gnome</url>
  <url type="contribute">https://github.com/codemyriad/cassini-gnome/blob/main/CONTRIBUTING.md</url>


  <provides>
    <binary>cassini-talk</binary>
    <mediatype>audio/opus</mediatype>
    <mediatype>audio/x-opus+ogg</mediatype>
    <mediatype>audio/mpeg</mediatype>
    <mediatype>audio/mp3</mediatype>
    <mediatype>audio/mp4</mediatype>
    <mediatype>audio/x-m4a</mediatype>
    <mediatype>audio/m4a</mediatype>
    <mediatype>audio/mp4a-latm</mediatype>
    <mediatype>audio/wav</mediatype>
    <mediatype>audio/x-wav</mediatype>
    <mediatype>audio/vnd.wave</mediatype>
  </provides>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/codemyriad/cassini-gnome/main/data/screenshots/transcript.png</image>
      <caption>A meeting transcript following playback</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.4.2" date="2026-11-08">
      <description>
        <p>After upgrading, log out and back in so the new version takes effect.</p>
        <ul>
          <li>Listen by speaker with a listening bar, transcript actions, timeline markers and keyboard shortcuts</li>
          <li>Fix Nextcloud Talk discovery and keep participant names supplied by the meeting page</li>
          <li>Show companion health and why browser sound stopped, including in saved recordings</li>
          <li>Alert once when an automatic recording switches from lost browser sound to computer audio</li>
          <li>Keep background connection logs and refresh an old service when it is idle</li>
          <li>Replace old cassini-viewer packages cleanly and improve missing-audio accounting</li>
          <li>Bundle companion 0.2.25 and call-signal groundwork; no site has verified detection through it yet</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-11-06">
      <description>
        <p>After upgrading, log out and back in so the new version takes effect.</p>
        <ul>
          <li>Speaker names wrap correctly, including in wide windows</li>
          <li>Search playback stays usable with a screen reader when results refresh</li>
          <li>Browser Stop and automatic-recording choices are kept while recordings save</li>
          <li>Browser audio is buffered through brief computer stalls, and Stop stays responsive</li>
          <li>Browser companion 0.2.15 keeps more accurate timing through brief browser stalls</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-11-05">
      <description>
        <p>Cassini is now called Cassini talk. Recording starts reliably on a silent computer,
        and a source that cannot open says why.</p>
        <ul>
          <li>Silent sources are saved as exact silence, and every track is placed at the same start
          for playback, transcripts and speakers</li>
          <li>Set up the browser companion from Cassini, keep browser recordings through page reloads,
          and record automatically with no window open</li>
          <li>A live spectrogram, Recording details and a test recording while you record</li>
          <li>Move meetings to Trash with Undo, rename with F2, and use Cassini in Italian, French,
          Spanish and Portuguese</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-29">
      <description>
        <p>Keep recordings and received meetings in the Library, follow their transcripts,
        search across meetings, and import or export audio and transcripts.</p>
        <ul>
          <li>Record browser meetings independently, choose what is recorded, and set up
          the companion in native packages or Flatpak</li>
          <li>Write meetings down locally with bundled Whistle or optional Parakeet Ultra</li>
          <li>Tell speakers apart, name and merge speakers, and remember saved voices locally</li>
          <li>Keep audio aligned through input interruptions without adding silence for gradual clock drift</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-27">
      <description>
        <p>Record meetings: the microphone and desktop audio, and browser meetings source by source
        through the Cassini companion extension. Cassini now names missing libraries and plugins
        at startup instead of failing.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-15">
      <description>
        <p>Fix transcript-click crashes and label sizing warnings. Keep participants visible,
        rejoin interrupted speech with inline interjections, and preserve interjections in exports.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-15">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
