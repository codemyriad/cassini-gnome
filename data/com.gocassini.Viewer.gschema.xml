<schemalist gettext-domain="cassini-viewer">
  <schema id="com.gocassini.Viewer" path="/com/gocassini/Viewer/">
    <key name="speech-model" type="s"><default>'whistle'</default><choices><choice value="whistle"/><choice value="parakeet-ultra-0.6b-int8"/></choices><summary>Speech model for new jobs</summary></key>
    <key name="record-shortcut-enabled" type="b"><default>false</default><summary>Global recording shortcut explicitly enabled</summary></key>
    <key name="record-shortcut-description" type="s"><default>'Ctrl+Alt+R'</default><summary>Desktop recording shortcut description</summary></key>
    <key name="browser-ever-connected" type="b"><default>false</default><summary>Browser companion has connected before</summary></key>
    <key name="background-notification-shown" type="b"><default>false</default><summary>Windowless automatic recording notification shown</summary></key>
    <key name="skip-record-first" type="b"><default>false</default><summary>Skip recording introduction</summary></key>
    <key name="export-folder-uri" type="s"><default>''</default><summary>Last folder selected for export</summary></key>
    <key name="companion-card-dismissed" type="b"><default>false</default><summary>Companion card dismissed</summary></key>
    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>780</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="show-sidebar" type="b">
      <default>true</default>
      <summary>Show the speakers sidebar</summary>
    </key>
    <key name="show-properties" type="b">
      <default>true</default>
      <summary>Show the properties pane</summary>
    </key>
    <key name="follow-along" type="b">
      <default>true</default>
      <summary>Follow along</summary>
      <description>Keep the word being spoken in view while playing.</description>
    </key>
  </schema>
</schemalist>
