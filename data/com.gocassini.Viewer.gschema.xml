<schemalist gettext-domain="cassini-viewer">
  <schema id="com.gocassini.Viewer" path="/com/gocassini/Viewer/">
    <key name="companion-card-dismissed" type="b"><default>false</default><summary>Companion card dismissed</summary></key>
    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>780</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="show-sidebar" type="b">
      <default>true</default>
      <summary>Show the speakers sidebar</summary>
    </key>
    <key name="show-properties" type="b">
      <default>true</default>
      <summary>Show the properties pane</summary>
    </key>
    <key name="follow-along" type="b">
      <default>true</default>
      <summary>Follow along</summary>
      <description>Keep the word being spoken in view while playing.</description>
    </key>
  </schema>
</schemalist>
