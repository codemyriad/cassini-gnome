[Desktop Entry]
Name=@APP_NAME@
GenericName=Meeting Player
Comment=Play meeting recordings and read along with their transcripts
Exec=cassini-talk %U
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=meeting;transcript;recording;opus;captions;speech;
MimeType=audio/opus;audio/x-opus+ogg;audio/mpeg;audio/mp3;audio/mp4;audio/x-m4a;audio/m4a;audio/mp4a-latm;audio/wav;audio/x-wav;audio/vnd.wave;
StartupNotify=true
DBusActivatable=true
