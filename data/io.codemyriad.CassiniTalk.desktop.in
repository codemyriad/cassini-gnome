[Desktop Entry]
Name=@APP_NAME@
GenericName=Meeting Player
Comment=Play meeting recordings and read along with their transcripts
Exec=cassini-talk %U
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=meeting;transcript;recording;opus;captions;speech;
MimeType=audio/ogg;audio/x-opus+ogg;audio/opus;
StartupNotify=true
DBusActivatable=true
