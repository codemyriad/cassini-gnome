[Desktop Entry]
Name=@APP_NAME@
GenericName=Meeting Recorder
Comment=Record meetings and write them down on this computer
Exec=cassini-talk %U
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Recorder;Player;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=meeting;transcript;recording;opus;captions;speech;
MimeType=audio/opus;audio/x-opus+ogg;audio/mpeg;audio/mp3;audio/mp4;audio/x-m4a;audio/m4a;audio/mp4a-latm;audio/wav;audio/x-wav;audio/vnd.wave;audio/flac;audio/x-flac;
StartupNotify=true
DBusActivatable=true
